# Web3Forms API Key (contact form)
# 1. Get your free Access Key at https://web3forms.com (enter your email to receive a key)
# 2. Add it here or in Vercel/Netlify Environment Variables as VITE_WEB3FORMS_ACCESS_KEY
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Your live site URL (no trailing slash needed). Enables canonical URL, sitemap.xml
# and an absolute Open Graph image. Leave empty until you have a domain.
VITE_SITE_URL=

# Umami analytics (optional, privacy-friendly). Loaded only when BOTH are set.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional: turn Haunt (the chat mascot) into an AI chatbot.
# Point this at YOUR OWN endpoint (e.g. a serverless function that calls an LLM
# with src/content.ts as context). The page POSTs { question, history } and
# expects { text, links? }. Leave empty to use the offline answers from content.ts.
# Never put API keys in VITE_* variables: they are visible in the browser.
VITE_HAUNT_API_URL=
